{
  "version": "alpha",
  "name": "Airbnb Web Study",
  "description": "A screenshot-derived design system for Airbnb home discovery, search, wishlists, and local stay selection.",
  "colors": {
    "primary": "#FF385C",
    "primary-dark": "#E31C5F",
    "ink": "#222222",
    "muted": "#6A6A6A",
    "surface": "#FFFFFF",
    "surface-subtle": "#F7F7F7",
    "border": "#DDDDDD",
    "border-subtle": "#EBEBEB",
    "action-gradient-start": "#E51D51",
    "action-gradient-end": "#D70466"
  },
  "typography": {
    "headline-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "30px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "-0.6px"
    },
    "headline-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "23px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "-0.6px"
    },
    "headline-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "20px",
      "fontWeight": 600,
      "lineHeight": 1.2
    },
    "body-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "body-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "body-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 600,
      "lineHeight": 1.25
    },
    "label-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 600,
      "lineHeight": 1.25
    },
    "label-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 600,
      "lineHeight": 1.25
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "rounded": {
    "control": "8px",
    "toast": "14px",
    "card": "22px",
    "modal": "26px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px",
    "gutter": "14px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.action-gradient-start}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.control}",
      "typography": "{typography.label-md}",
      "height": "48px"
    },
    "button-secondary": {
      "backgroundColor": "{colors.ink}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.control}",
      "typography": "{typography.label-md}",
      "height": "48px"
    },
    "search-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.full}",
      "size": "58px"
    },
    "stay-photo": {
      "rounded": "{rounded.card}"
    },
    "favorite-badge": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.full}",
      "typography": "{typography.label-sm}"
    },
    "dialog": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.modal}",
      "padding": "{spacing.lg}"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.action-gradient-end}",
      "textColor": "{colors.surface}"
    },
    "search-button-hover": {
      "backgroundColor": "{colors.primary-dark}",
      "textColor": "{colors.surface}"
    },
    "listing-metadata": {
      "textColor": "{colors.muted}",
      "typography": "{typography.body-sm}"
    },
    "footer": {
      "backgroundColor": "{colors.surface-subtle}",
      "textColor": "{colors.muted}",
      "typography": "{typography.body-sm}"
    },
    "menu-divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "header-divider": {
      "backgroundColor": "{colors.border-subtle}",
      "height": "1px"
    }
  }
}
