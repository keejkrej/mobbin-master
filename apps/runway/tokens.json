{
  "version": "alpha",
  "name": "Runway \u2014 Creative generator workspace",
  "description": "A Mobbin-derived study of the Runway Tool and Chat workspace, with inferred local interaction states.",
  "colors": {
    "primary": "#3420fa",
    "primary-hover": "#2914dd",
    "canvas": "#f2f3f5",
    "surface": "#ffffff",
    "text": "#101113",
    "muted": "#666a73",
    "border": "#e0e2e6",
    "selected": "#e1e4e9",
    "hover": "#eceef1"
  },
  "typography": {
    "feature": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "29px",
      "fontWeight": 600,
      "lineHeight": 1.2
    },
    "heading": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "20px",
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "prompt": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "control": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "sm": "5px",
    "md": "8px",
    "lg": "12px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "compact": "12px",
    "md": "16px",
    "lg": "24px",
    "rail": "57px",
    "panel": "381px",
    "banner": "42px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}"
    },
    "tool-panel": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "width": "{spacing.panel}"
    },
    "primary-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.md}",
      "typography": "{typography.body}"
    },
    "primary-button-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "prompt": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "typography": "{typography.prompt}",
      "rounded": "{rounded.md}",
      "padding": "{spacing.compact}"
    },
    "navigation-selected": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.md}"
    },
    "navigation-hover": {
      "backgroundColor": "{colors.hover}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "control": {
      "textColor": "{colors.muted}",
      "typography": "{typography.control}"
    },
    "feature-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.feature}"
    },
    "dialog-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.heading}"
    },
    "caption": {
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "preset": {
      "backgroundColor": "{colors.hover}",
      "textColor": "{colors.muted}",
      "rounded": "{rounded.full}",
      "typography": "{typography.control}"
    }
  }
}
