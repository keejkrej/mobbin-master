{
  "version": "alpha",
  "name": "Lovable \u2014 Project builder study",
  "description": "A screenshot-derived Lovable web design system with an editable local portfolio preview.",
  "colors": {
    "primary": "#2456e9",
    "text": "#20211f",
    "muted": "#666864",
    "canvas": "#fdfbf9",
    "surface": "#ffffff",
    "cream": "#f8f4ec",
    "border": "#e7e7e2",
    "selected": "#dce5fb",
    "preview": "#f8f7f3",
    "preview-text": "#20252b",
    "preview-muted": "#6d717d",
    "sage": "#416f5b",
    "danger": "#c8100b",
    "purple": "#5733c7",
    "blue": "#5e8cff",
    "pink": "#f544ad",
    "orange": "#ff602e"
  },
  "typography": {
    "body": {
      "fontFamily": "Inter",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "toolbar": {
      "fontFamily": "Inter",
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "label": {
      "fontFamily": "Inter",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Inter",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "home-heading": {
      "fontFamily": "Inter",
      "fontSize": "26px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "-0.04em"
    },
    "dialog-heading": {
      "fontFamily": "Inter",
      "fontSize": "22px",
      "fontWeight": 600,
      "lineHeight": 1.3,
      "letterSpacing": "-0.02em"
    },
    "portfolio-heading": {
      "fontFamily": "Georgia",
      "fontSize": "69px",
      "fontWeight": 400,
      "lineHeight": 1.02,
      "letterSpacing": "-0.025em"
    },
    "portfolio-name": {
      "fontFamily": "Georgia",
      "fontSize": "22px",
      "fontWeight": 400,
      "lineHeight": 1.2
    },
    "portfolio-body": {
      "fontFamily": "Inter",
      "fontSize": "19px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "portfolio-eyebrow": {
      "fontFamily": "Inter",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "small": "6px",
    "medium": "10px",
    "large": "16px",
    "composer": "24px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "base": "16px",
    "large": "24px",
    "toolbar": "46px",
    "sidebar": "260px",
    "settings-nav": "230px",
    "icon": "30px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "typography": "{typography.body}"
    },
    "toolbar": {
      "height": "{spacing.toolbar}",
      "typography": "{typography.toolbar}"
    },
    "primary-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.small}"
    },
    "dark-button": {
      "backgroundColor": "{colors.text}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.small}"
    },
    "danger-button": {
      "backgroundColor": "{colors.danger}",
      "textColor": "{colors.surface}"
    },
    "composer": {
      "backgroundColor": "{colors.cream}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.composer}"
    },
    "version-card": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.text}",
      "typography": "{typography.label}"
    },
    "muted-label": {
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "home-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.home-heading}"
    },
    "dialog-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.dialog-heading}"
    },
    "portfolio": {
      "backgroundColor": "{colors.preview}",
      "textColor": "{colors.preview-text}"
    },
    "portfolio-heading": {
      "textColor": "{colors.preview-text}",
      "typography": "{typography.portfolio-heading}"
    },
    "portfolio-name": {
      "textColor": "{colors.preview-text}",
      "typography": "{typography.portfolio-name}"
    },
    "portfolio-description": {
      "backgroundColor": "{colors.preview}",
      "textColor": "{colors.preview-muted}",
      "typography": "{typography.portfolio-body}"
    },
    "portfolio-eyebrow": {
      "textColor": "{colors.sage}",
      "typography": "{typography.portfolio-eyebrow}"
    },
    "portfolio-action": {
      "backgroundColor": "{colors.sage}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.full}"
    },
    "workspace-avatar": {
      "backgroundColor": "{colors.purple}",
      "textColor": "{colors.surface}"
    },
    "brand-gradient-blue": {
      "backgroundColor": "{colors.blue}"
    },
    "brand-gradient-pink": {
      "backgroundColor": "{colors.pink}"
    },
    "brand-gradient-orange": {
      "backgroundColor": "{colors.orange}"
    }
  }
}
