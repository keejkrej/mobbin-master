{
  "version": "alpha",
  "name": "General Intuition official-site study",
  "description": "Official-source reconstruction of an expressive frontier research laboratory website.",
  "colors": {
    "primary": "#FFFFFF",
    "canvas": "#000000",
    "surface": "#08090C",
    "raised": "#111218",
    "text": "#FFFFFF",
    "muted": "#BCBCBC",
    "label": "#8A8A8A",
    "line": "#727275",
    "dark": "#000000",
    "track": "#45494F",
    "thumb": "#DDDDDD",
    "focus": "#91C8FF"
  },
  "typography": {
    "display-mission": {
      "fontFamily": "Alpha Lyrae",
      "fontSize": "24px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "headline-lg": {
      "fontFamily": "Alpha Lyrae",
      "fontSize": "36px",
      "fontWeight": 400,
      "lineHeight": 1.25
    },
    "headline-md": {
      "fontFamily": "Alpha Lyrae",
      "fontSize": "30px",
      "fontWeight": 400,
      "lineHeight": 1.25
    },
    "body-md": {
      "fontFamily": "Geist",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.7
    },
    "body-sm": {
      "fontFamily": "Geist",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.7
    },
    "quote": {
      "fontFamily": "Geist",
      "fontSize": "27px",
      "fontWeight": 400,
      "lineHeight": 1.75
    },
    "label-lg": {
      "fontFamily": "Geist Mono",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label-md": {
      "fontFamily": "Geist Mono",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "button": {
      "fontFamily": "Geist",
      "fontSize": "16px",
      "fontWeight": 500,
      "lineHeight": 1.2
    },
    "caption": {
      "fontFamily": "Geist",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "rounded": {
    "none": "0px",
    "sm": "2px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "32px",
    "xl": "50px",
    "xxl": "100px",
    "inner-width": "1152px"
  },
  "components": {
    "app-canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "editorial-surface": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.muted}",
      "typography": "{typography.body-md}",
      "padding": "{spacing.xl}"
    },
    "control-surface": {
      "backgroundColor": "{colors.raised}",
      "textColor": "{colors.label}"
    },
    "inverted-mission": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.dark}",
      "typography": "{typography.display-mission}",
      "rounded": "{rounded.none}"
    },
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.dark}",
      "typography": "{typography.button}"
    },
    "grid-rule": {
      "backgroundColor": "{colors.line}",
      "width": "1px"
    },
    "slider-track": {
      "backgroundColor": "{colors.track}",
      "height": "5px",
      "rounded": "{rounded.full}"
    },
    "slider-thumb": {
      "backgroundColor": "{colors.thumb}",
      "width": "35px",
      "height": "18px",
      "rounded": "{rounded.full}"
    },
    "focus-indicator": {
      "backgroundColor": "{colors.focus}",
      "width": "2px"
    },
    "section-label": {
      "textColor": "{colors.label}",
      "typography": "{typography.label-md}"
    }
  }
}
