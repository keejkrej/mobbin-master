{
  "version": "alpha",
  "name": "Decart Live AI Lab",
  "description": "Official-site study of Decart’s blue and white Live AI lab identity.",
  "colors": {
    "primary": "#2548F6",
    "primary-hover": "#193BD8",
    "text": "#101010",
    "muted": "#656565",
    "surface": "#FFFFFF",
    "subtle": "#F5F5F5",
    "ice": "#EFF7FF",
    "footer": "#22222C",
    "line": "#DEDEE2"
  },
  "typography": {
    "headline-display": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "65px",
      "fontWeight": 400,
      "lineHeight": 1.12,
      "letterSpacing": "-3.25px"
    },
    "headline-mobile": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "40px",
      "fontWeight": 400,
      "lineHeight": 1.12,
      "letterSpacing": "-1.8px"
    },
    "headline-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "52px",
      "fontWeight": 400,
      "lineHeight": 1.12,
      "letterSpacing": "-2.08px"
    },
    "headline-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "48px",
      "fontWeight": 400,
      "lineHeight": 1.24,
      "letterSpacing": "-1.92px"
    },
    "headline-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "22px",
      "fontWeight": 400,
      "lineHeight": 1.4,
      "letterSpacing": "-0.66px"
    },
    "body-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "body-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "label-button": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": 1.25
    },
    "label-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "rounded": {
    "small": "12px",
    "card": "56px",
    "pill": "9999px"
  },
  "spacing": {
    "xs": "8px",
    "sm": "16px",
    "md": "24px",
    "lg": "40px",
    "xl": "64px",
    "section": "140px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.pill}",
      "typography": "{typography.label-button}"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.primary-hover}",
      "textColor": "{colors.surface}"
    },
    "page": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "typography": "{typography.body-md}"
    },
    "supporting-text": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "capability-card": {
      "backgroundColor": "{colors.subtle}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.card}",
      "padding": "{spacing.md}"
    },
    "manifesto": {
      "backgroundColor": "{colors.ice}",
      "textColor": "{colors.primary}",
      "typography": "{typography.headline-md}"
    },
    "footer": {
      "backgroundColor": "{colors.footer}",
      "textColor": "{colors.surface}"
    },
    "input-border": {
      "backgroundColor": "{colors.line}"
    },
    "dialog": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "padding": "{spacing.lg}"
    }
  }
}
