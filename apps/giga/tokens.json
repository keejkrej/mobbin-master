{
  "version": "alpha",
  "name": "Giga — Forest and conversation study",
  "description": "A Mobbin-grounded marketing interface combining Giga’s forest-era hero with adapted newer voice and omnichannel sections.",
  "colors": {
    "primary": "#ffffff",
    "ink": "#101514",
    "canvas": "#041326",
    "text": "#eff3f4",
    "muted": "#aeb9c4",
    "border": "#344354",
    "sky": "#4c6c7c",
    "horizon": "#a59b96",
    "forest": "#0b1618",
    "blue": "#31a8e8",
    "violet": "#703b80",
    "rust": "#8b4d3a",
    "phone": "#695047",
    "bubble": "#101e2e",
    "danger": "#ff333c",
    "success": "#287954"
  },
  "typography": {
    "hero": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "66px",
      "fontWeight": 400,
      "lineHeight": 1.15
    },
    "section": {
      "fontFamily": "Geist Pixel Line, Courier New, monospace",
      "fontSize": "46px",
      "fontWeight": 400,
      "lineHeight": 1.15
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "navigation": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "eyebrow": {
      "fontFamily": "Courier New, monospace",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "chat": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.65
    },
    "dialog-title": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "34px",
      "fontWeight": 400,
      "lineHeight": 1.1
    },
    "dialog-body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.7
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "small": "8px",
    "card": "20px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "base": "16px",
    "large": "24px",
    "gutter": "43px",
    "section": "110px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.full}",
      "typography": "{typography.navigation}",
      "height": "41px"
    },
    "canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "metadata": {
      "textColor": "{colors.muted}",
      "typography": "{typography.eyebrow}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "hero-sky": {
      "backgroundColor": "{colors.sky}"
    },
    "hero-horizon": {
      "backgroundColor": "{colors.horizon}"
    },
    "hero-foreground": {
      "backgroundColor": "{colors.forest}"
    },
    "hero-heading": {
      "textColor": "{colors.primary}",
      "typography": "{typography.hero}"
    },
    "section-heading": {
      "typography": "{typography.section}"
    },
    "section-copy": {
      "typography": "{typography.body}"
    },
    "section-marker": {
      "backgroundColor": "{colors.blue}",
      "width": "5px",
      "height": "5px"
    },
    "conversation-glow": {
      "backgroundColor": "{colors.violet}"
    },
    "voice-marker": {
      "backgroundColor": "{colors.rust}",
      "width": "5px",
      "height": "5px"
    },
    "phone": {
      "backgroundColor": "{colors.phone}",
      "width": "310px"
    },
    "chat-bubble": {
      "backgroundColor": "{colors.bubble}",
      "textColor": "{colors.text}",
      "typography": "{typography.chat}",
      "rounded": "14px"
    },
    "end-call": {
      "backgroundColor": "{colors.danger}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.full}",
      "height": "35px"
    },
    "start-call": {
      "backgroundColor": "{colors.success}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.full}",
      "height": "35px"
    },
    "dialog": {
      "rounded": "{rounded.card}",
      "padding": "30px"
    },
    "dialog-heading": {
      "textColor": "{colors.ink}",
      "typography": "{typography.dialog-title}"
    },
    "dialog-description": {
      "typography": "{typography.dialog-body}"
    },
    "input": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.small}",
      "typography": "{typography.label}",
      "height": "42px"
    }
  }
}
