{
  "version": "alpha",
  "name": "Google Gemini \u2014 Mobbin Study",
  "description": "Inferred design tokens from Google Gemini home and temporary-chat screenshots.",
  "colors": {
    "primary": "#232625",
    "secondary": "#696c6e",
    "canvas": "#fdfdfd",
    "surface": "#ffffff",
    "selected": "#f0eeee",
    "border": "#e6e6e6",
    "glow": "#c2e4fc",
    "temporary-glow": "#dededc",
    "focus": "#0b57d0",
    "blue": "#4285f4",
    "red": "#ea4335",
    "yellow": "#fbbc05",
    "green": "#34a853"
  },
  "typography": {
    "headline-lg": {
      "fontFamily": "Inter",
      "fontSize": "36px",
      "fontWeight": 400,
      "lineHeight": 1.25,
      "letterSpacing": "-0.04em"
    },
    "headline-md": {
      "fontFamily": "Inter",
      "fontSize": "24px",
      "fontWeight": 400,
      "lineHeight": 1.3,
      "letterSpacing": "-0.02em"
    },
    "body-md": {
      "fontFamily": "Inter",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "body-sm": {
      "fontFamily": "Inter",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label-md": {
      "fontFamily": "Inter",
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "label-sm": {
      "fontFamily": "Inter",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "composer": {
      "fontFamily": "Inter",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "rounded": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "sidebar": "280px",
    "rail": "56px",
    "composer": "672px",
    "control": "36px"
  },
  "components": {
    "composer": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.primary}",
      "typography": "{typography.composer}",
      "rounded": "{rounded.full}",
      "height": "64px",
      "padding": "{spacing.md}",
      "width": "{spacing.composer}"
    },
    "navigation-selected": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.full}",
      "typography": "{typography.label-md}",
      "height": "32px"
    },
    "icon-button": {
      "textColor": "{colors.primary}",
      "rounded": "{rounded.full}",
      "size": "{spacing.control}"
    },
    "user-message": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.lg}",
      "typography": "{typography.body-md}",
      "padding": "{spacing.md}"
    },
    "main-canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.primary}"
    },
    "ambient-glow": {
      "backgroundColor": "{colors.glow}"
    },
    "temporary-ambient-glow": {
      "backgroundColor": "{colors.temporary-glow}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "focus-indicator": {
      "backgroundColor": "{colors.focus}",
      "size": "2px"
    },
    "google-mark-blue": {
      "textColor": "{colors.blue}"
    },
    "google-mark-red": {
      "textColor": "{colors.red}"
    },
    "google-mark-yellow": {
      "textColor": "{colors.yellow}"
    },
    "google-mark-green": {
      "textColor": "{colors.green}"
    }
  }
}
