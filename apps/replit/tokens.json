{
  "version": "alpha",
  "name": "Replit \u2014 Projects and workspace study",
  "description": "Screenshot-derived dark projects gallery and light agent workspace, observed in Mobbin on November 16, 2026.",
  "colors": {
    "primary": "#0088ff",
    "primary-hover": "#0077e0",
    "canvas": "#1e1e1e",
    "sidebar": "#222222",
    "card": "#242424",
    "border": "#303030",
    "control-border": "#454545",
    "text": "#dedede",
    "muted": "#a5a5a5",
    "hover": "#2b2b2b",
    "orange": "#f36c00",
    "white": "#ffffff",
    "light-canvas": "#f1f1ef",
    "light-surface": "#f8f8f6",
    "light-border": "#d9d9d3",
    "light-text": "#262723",
    "light-muted": "#696b65"
  },
  "typography": {
    "heading": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "22px",
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "small": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "9px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "dialog-heading": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "20px",
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "code": {
      "fontFamily": "Courier New, monospace",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 2
    }
  },
  "rounded": {
    "small": "5px",
    "medium": "8px",
    "card": "12px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "base": "16px",
    "large": "24px",
    "sidebar": "202px",
    "agent": "380px",
    "rail": "38px",
    "gallery-gutter": "13px"
  },
  "components": {
    "gallery": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "typography": "{typography.body}"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "textColor": "{colors.text}",
      "width": "{spacing.sidebar}"
    },
    "project-card": {
      "backgroundColor": "{colors.card}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.card}",
      "typography": "{typography.label}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "input-border": {
      "backgroundColor": "{colors.control-border}",
      "height": "1px"
    },
    "metadata": {
      "textColor": "{colors.muted}",
      "typography": "{typography.small}"
    },
    "navigation-hover": {
      "backgroundColor": "{colors.hover}"
    },
    "brand-mark": {
      "textColor": "{colors.orange}"
    },
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.white}",
      "rounded": "{rounded.small}",
      "height": "28px",
      "typography": "{typography.label}"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "workspace": {
      "backgroundColor": "{colors.light-canvas}",
      "textColor": "{colors.light-text}",
      "typography": "{typography.body}"
    },
    "agent-pane": {
      "backgroundColor": "{colors.light-surface}",
      "textColor": "{colors.light-text}",
      "width": "{spacing.agent}"
    },
    "workspace-divider": {
      "backgroundColor": "{colors.light-border}",
      "height": "1px"
    },
    "workspace-metadata": {
      "textColor": "{colors.light-muted}",
      "typography": "{typography.caption}"
    },
    "gallery-heading": {
      "typography": "{typography.heading}",
      "textColor": "{colors.text}"
    },
    "dialog-heading": {
      "typography": "{typography.dialog-heading}"
    },
    "code-editor": {
      "typography": "{typography.code}"
    }
  }
}
