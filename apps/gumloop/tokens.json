{
  "version": "alpha",
  "name": "Gumloop \u2014 Workflows and node builder",
  "description": "Screenshot-derived Gumloop workflow gallery and Google Sheets Reader builder, with local sample execution.",
  "colors": {
    "primary": "#282828",
    "primary-hover": "#414141",
    "canvas": "#fdfdfd",
    "sidebar": "#f9f9f9",
    "surface": "#ffffff",
    "text": "#111214",
    "muted": "#737780",
    "border": "#e4e4e4",
    "selected": "#f1f1f1",
    "run": "#f32d9a",
    "enabled": "#57d98b",
    "node-tint": "#e3fced",
    "save": "#ffebca",
    "save-text": "#97631e",
    "credit": "#009aff"
  },
  "typography": {
    "page-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "24px",
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "card-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "node-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "23px",
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "node-body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "navigation": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "sm": "6px",
    "md": "10px",
    "lg": "18px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "compact": "12px",
    "md": "16px",
    "lg": "24px",
    "sidebar": "244px",
    "chat-panel": "500px",
    "node-width": "586px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "textColor": "{colors.text}",
      "width": "{spacing.sidebar}"
    },
    "primary-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.sm}",
      "typography": "{typography.body}"
    },
    "primary-button-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "workflow-card": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.md}",
      "padding": "{spacing.md}",
      "typography": "{typography.body}"
    },
    "card-title": {
      "textColor": "{colors.text}",
      "typography": "{typography.card-title}"
    },
    "navigation-selected": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.text}",
      "typography": "{typography.navigation}",
      "rounded": "{rounded.sm}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "metadata": {
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "page-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.page-title}"
    },
    "node-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.node-title}"
    },
    "node-surface": {
      "backgroundColor": "{colors.node-tint}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.lg}",
      "typography": "{typography.node-body}"
    },
    "enabled-switch": {
      "backgroundColor": "{colors.enabled}",
      "rounded": "{rounded.md}"
    },
    "save-button": {
      "backgroundColor": "{colors.save}",
      "textColor": "{colors.save-text}",
      "rounded": "{rounded.sm}"
    },
    "run-button": {
      "backgroundColor": "{colors.run}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.sm}"
    },
    "credits-button": {
      "backgroundColor": "{colors.credit}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.sm}"
    }
  }
}
