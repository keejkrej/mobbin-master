{
  "version": "alpha",
  "name": "Linear — Light workspace study",
  "description": "A screenshot-derived design system for the AS Mobbin Linear workspace, observed on November 16, 2026.",
  "colors": {
    "primary": "#7275cf",
    "primary-hover": "#6265bf",
    "canvas": "#f3f3f3",
    "surface": "#fdfdfd",
    "elevated": "#ffffff",
    "hover": "#eeeeef",
    "selected": "#e6e6e7",
    "group": "#f4f4f5",
    "border": "#e9e9eb",
    "text": "#17181a",
    "secondary": "#626369",
    "muted": "#92929b",
    "done": "#6870c8",
    "progress": "#e9bc23",
    "teal": "#23afc1"
  },
  "typography": {
    "title": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "23px",
      "fontWeight": 600,
      "lineHeight": 1.3
    },
    "modal-title": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "18px",
      "fontWeight": 600,
      "lineHeight": 1.3
    },
    "body": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "body-medium": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "13px",
      "fontWeight": 500,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "label-small": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.3
    }
  },
  "rounded": {
    "small": "5px",
    "medium": "9px",
    "panel": "14px",
    "modal": "22px",
    "pill": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "medium": "12px",
    "base": "16px",
    "large": "24px",
    "sidebar": "232px",
    "header": "44px",
    "row": "42px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.elevated}",
      "rounded": "{rounded.pill}",
      "typography": "{typography.label}",
      "height": "28px",
      "padding": "7px"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "navigation-item": {
      "textColor": "{colors.secondary}",
      "rounded": "6px",
      "height": "28px",
      "padding": "8px"
    },
    "navigation-item-selected": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.text}"
    },
    "issue-row": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "typography": "{typography.body}",
      "height": "{spacing.row}"
    },
    "issue-group": {
      "backgroundColor": "{colors.group}",
      "textColor": "{colors.text}",
      "rounded": "7px",
      "height": "34px"
    },
    "modal": {
      "backgroundColor": "{colors.elevated}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.modal}",
      "width": "715px"
    },
    "workspace-panel": {
      "backgroundColor": "{colors.surface}",
      "rounded": "{rounded.panel}"
    },
    "workspace-canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "icon-button-hover": {
      "backgroundColor": "{colors.hover}",
      "textColor": "{colors.text}"
    },
    "control-outline-stroke": {
      "backgroundColor": "{colors.border}",
      "width": "1px"
    },
    "muted-label": {
      "textColor": "{colors.muted}",
      "typography": "{typography.label-small}"
    },
    "status-done": {
      "backgroundColor": "{colors.done}",
      "textColor": "{colors.elevated}",
      "rounded": "{rounded.pill}",
      "size": "13px"
    },
    "status-progress-fill": {
      "backgroundColor": "{colors.progress}",
      "rounded": "{rounded.pill}"
    },
    "issue-label-dot": {
      "backgroundColor": "{colors.teal}",
      "rounded": "{rounded.pill}",
      "size": "9px"
    }
  }
}
