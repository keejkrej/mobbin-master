{
  "version": "alpha",
  "name": "Bolt.new interface study",
  "description": "Screenshot-informed dark prompt builder and white portfolio preview.",
  "colors": {
    "primary": "#438DF4",
    "primary-hover": "#337BE0",
    "canvas": "#101010",
    "surface": "#171717",
    "raised": "#262626",
    "border": "#343434",
    "text": "#FAFAFA",
    "muted": "#AAAAAA",
    "subtle": "#828282",
    "preview": "#FFFFFF",
    "preview-text": "#202735",
    "preview-muted": "#515560",
    "preview-accent": "#365FE3",
    "preview-subtle": "#F8FAFC"
  },
  "typography": {
    "headline-display": {
      "fontFamily": "Inter",
      "fontSize": "44px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "-1.5px"
    },
    "body-lg": {
      "fontFamily": "Inter",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "body-md": {
      "fontFamily": "Inter",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.65
    },
    "body-sm": {
      "fontFamily": "Inter",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label-md": {
      "fontFamily": "Inter",
      "fontSize": "12px",
      "fontWeight": 500,
      "lineHeight": 1.2
    },
    "label-sm": {
      "fontFamily": "Inter",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "preview-title": {
      "fontFamily": "Inter",
      "fontSize": "44px",
      "fontWeight": 700,
      "lineHeight": 1.3,
      "letterSpacing": "-1.15px"
    },
    "preview-body": {
      "fontFamily": "Inter",
      "fontSize": "19px",
      "fontWeight": 400,
      "lineHeight": 1.65,
      "letterSpacing": "-0.5px"
    },
    "preview-heading": {
      "fontFamily": "Inter",
      "fontSize": "34px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "-0.7px"
    }
  },
  "rounded": {
    "sm": "5px",
    "md": "8px",
    "lg": "12px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "header-height": "52px",
    "rail-width": "48px"
  },
  "components": {
    "app-shell": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "composer": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.sm}",
      "typography": "{typography.body-md}"
    },
    "composer-placeholder": {
      "textColor": "{colors.subtle}"
    },
    "user-message": {
      "backgroundColor": "{colors.raised}",
      "textColor": "{colors.text}",
      "padding": "{spacing.md}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.preview}",
      "rounded": "{rounded.sm}",
      "typography": "{typography.label-md}"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "supporting-text": {
      "textColor": "{colors.muted}",
      "typography": "{typography.body-sm}"
    },
    "portfolio-shell": {
      "backgroundColor": "{colors.preview}",
      "textColor": "{colors.preview-text}"
    },
    "portfolio-body": {
      "textColor": "{colors.preview-muted}",
      "typography": "{typography.preview-body}"
    },
    "portfolio-button": {
      "backgroundColor": "{colors.preview-accent}",
      "textColor": "{colors.preview}",
      "rounded": "{rounded.md}"
    },
    "case-studies": {
      "backgroundColor": "{colors.preview-subtle}",
      "textColor": "{colors.preview-text}",
      "typography": "{typography.preview-heading}"
    }
  }
}
