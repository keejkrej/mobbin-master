{
  "version": "alpha",
  "name": "Contra Labs \u2014 Creative AI and human taste",
  "description": "A Mobbin-grounded reconstruction of the creative AI evaluation lab, using cream paper, editorial serif typography, and Renaissance artwork.",
  "colors": {
    "primary": "#292c26",
    "paper": "#f2f1eb",
    "muted": "#61645c",
    "line": "#d2d3ca",
    "seafoam": "#c2ded9",
    "teal": "#2b7477",
    "ribbon": "#83aaa2",
    "white": "#fffef7",
    "focus": "#245e60",
    "error": "#9d342a"
  },
  "typography": {
    "hero": {
      "fontFamily": "Instrument Serif, Georgia, serif",
      "fontSize": "61px",
      "fontWeight": 400,
      "lineHeight": 1.02,
      "letterSpacing": "-0.035em"
    },
    "section-heading": {
      "fontFamily": "Instrument Serif, Georgia, serif",
      "fontSize": "48px",
      "fontWeight": 400,
      "lineHeight": 1,
      "letterSpacing": "-0.035em"
    },
    "card-heading": {
      "fontFamily": "Instrument Serif, Georgia, serif",
      "fontSize": "34px",
      "fontWeight": 400,
      "lineHeight": 1,
      "letterSpacing": "-0.03em"
    },
    "hero-body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "21px",
      "fontWeight": 400,
      "lineHeight": 1.25,
      "letterSpacing": "-0.025em"
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "navigation": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "eyebrow": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "letterSpacing": "1.4px"
    },
    "faq-answer": {
      "fontFamily": "Georgia, serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.45
    }
  },
  "rounded": {
    "sm": "4px",
    "md": "8px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "40px",
    "section": "112px"
  },
  "components": {
    "page": {
      "backgroundColor": "{colors.paper}",
      "textColor": "{colors.primary}"
    },
    "hero-heading": {
      "textColor": "{colors.primary}",
      "typography": "{typography.hero}"
    },
    "hero-description": {
      "textColor": "{colors.primary}",
      "typography": "{typography.hero-body}"
    },
    "section-heading": {
      "textColor": "{colors.primary}",
      "typography": "{typography.section-heading}"
    },
    "dark-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.white}",
      "rounded": "{rounded.full}",
      "typography": "{typography.navigation}"
    },
    "outline-button": {
      "rounded": "{rounded.full}"
    },
    "ecosystem": {
      "backgroundColor": "{colors.seafoam}",
      "textColor": "{colors.primary}"
    },
    "research-card": {
      "backgroundColor": "{colors.teal}",
      "textColor": "{colors.white}",
      "rounded": "{rounded.md}",
      "typography": "{typography.card-heading}"
    },
    "eyebrow": {
      "textColor": "{colors.primary}",
      "typography": "{typography.eyebrow}"
    },
    "ribbon": {
      "backgroundColor": "{colors.ribbon}"
    },
    "body": {
      "textColor": "{colors.primary}",
      "typography": "{typography.body}"
    },
    "faq-answer": {
      "textColor": "{colors.muted}",
      "typography": "{typography.faq-answer}"
    },
    "field": {
      "backgroundColor": "{colors.paper}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.sm}"
    },
    "dialog": {
      "backgroundColor": "{colors.paper}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.sm}",
      "padding": "{spacing.xl}"
    },
    "ribbon-star": {
      "backgroundColor": "{colors.paper}"
    },
    "divider": {
      "backgroundColor": "{colors.line}",
      "height": "1px"
    },
    "active-research-tab": {
      "textColor": "{colors.focus}"
    },
    "invalid-field-outline": {
      "backgroundColor": "{colors.error}"
    }
  }
}
