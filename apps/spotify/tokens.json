{
  "version": "alpha",
  "name": "Spotify web player study",
  "description": "An inferred dark music-player system from four Mobbin web references, retrieved November 16, 2026.",
  "colors": {
    "primary": "#1ed760",
    "primary-hover": "#3be477",
    "background": "#000000",
    "surface": "#121212",
    "surface-raised": "#1f1f1f",
    "surface-hover": "#2a2a2a",
    "surface-selected": "#333333",
    "on-surface": "#ffffff",
    "secondary": "#b3b3b3",
    "border": "#303030",
    "track": "#535353"
  },
  "typography": {
    "headline-display": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "104px",
      "fontWeight": 800,
      "lineHeight": 1.1,
      "letterSpacing": "-4px"
    },
    "headline-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "32px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "-0.8px"
    },
    "headline-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "24px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "-0.7px"
    },
    "body-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "body-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.45
    },
    "body-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "label-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "13px",
      "fontWeight": 700,
      "lineHeight": 1.2
    },
    "label-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "artwork": "3px",
    "row": "4px",
    "panel": "8px",
    "dialog": "9px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "32px",
    "header": "64px",
    "player": "88px",
    "track-row": "56px"
  },
  "components": {
    "button-play": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.background}",
      "rounded": "{rounded.full}",
      "size": "56px"
    },
    "button-play-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "button-secondary": {
      "backgroundColor": "{colors.on-surface}",
      "textColor": "{colors.background}",
      "rounded": "{rounded.full}",
      "typography": "{typography.label-md}",
      "padding": "16px"
    },
    "panel": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.on-surface}",
      "rounded": "{rounded.panel}"
    },
    "library-card": {
      "backgroundColor": "{colors.surface-raised}",
      "rounded": "{rounded.panel}",
      "padding": "20px"
    },
    "track-row": {
      "textColor": "{colors.on-surface}",
      "rounded": "{rounded.row}",
      "height": "{spacing.track-row}"
    },
    "search": {
      "backgroundColor": "{colors.surface-raised}",
      "textColor": "{colors.secondary}",
      "rounded": "{rounded.full}",
      "height": "48px"
    },
    "slider": {
      "backgroundColor": "{colors.track}",
      "height": "4px",
      "rounded": "{rounded.full}"
    },
    "chip": {
      "backgroundColor": "{colors.surface-hover}",
      "rounded": "{rounded.full}"
    },
    "lyrics-panel": {
      "backgroundColor": "{colors.surface-selected}",
      "textColor": "{colors.on-surface}"
    },
    "separator": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    }
  }
}
