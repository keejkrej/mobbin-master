{
  "version": "alpha",
  "name": "Perplexity \u2014 Search and connectors study",
  "description": "An inferred Perplexity web design system from Mobbin search-home and connector-management references retrieved November 16, 2026.",
  "colors": {
    "primary": "#09666a",
    "canvas": "#fbf7f6",
    "sidebar": "#f2eeeb",
    "surface": "#fffbfb",
    "canvas-connectors": "#faf8f6",
    "sidebar-connectors": "#f1f0ec",
    "text": "#22221f",
    "muted": "#706f6b",
    "border": "#dcd9d5",
    "hover": "#eae7e2",
    "feature": "#00686b",
    "feature-deep": "#071e20",
    "feature-text": "#e7f3f3",
    "dark": "#25251f"
  },
  "typography": {
    "wordmark": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "47px",
      "fontWeight": 400,
      "lineHeight": 1.15,
      "letterSpacing": "-2.9px"
    },
    "page-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "29px",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "-0.7px"
    },
    "section-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "21px",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "-0.5px"
    },
    "dialog-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "19px",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "-0.3px"
    },
    "composer": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.45
    },
    "answer": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.85
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "feature-label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.45
    }
  },
  "rounded": {
    "small": "8px",
    "medium": "12px",
    "large": "16px",
    "composer": "17px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "medium": "12px",
    "base": "16px",
    "large": "24px",
    "xl": "32px",
    "sidebar": "202px",
    "composer": "650px",
    "answer": "740px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}"
    },
    "canvas-connectors": {
      "backgroundColor": "{colors.canvas-connectors}"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "width": "{spacing.sidebar}"
    },
    "sidebar-connectors": {
      "backgroundColor": "{colors.sidebar-connectors}"
    },
    "sidebar-item": {
      "textColor": "{colors.muted}",
      "typography": "{typography.body}",
      "height": "41px"
    },
    "sidebar-item-active": {
      "backgroundColor": "{colors.hover}",
      "textColor": "{colors.text}"
    },
    "wordmark": {
      "textColor": "{colors.text}",
      "typography": "{typography.wordmark}"
    },
    "composer": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "typography": "{typography.composer}",
      "rounded": "{rounded.composer}",
      "width": "{spacing.composer}"
    },
    "feature-search": {
      "backgroundColor": "{colors.feature}",
      "textColor": "{colors.feature-text}",
      "typography": "{typography.feature-label}",
      "rounded": "{rounded.medium}"
    },
    "feature-computer": {
      "backgroundColor": "{colors.feature-deep}",
      "textColor": "{colors.feature-text}",
      "rounded": "{rounded.medium}"
    },
    "feature-description": {
      "typography": "{typography.caption}"
    },
    "button-primary": {
      "backgroundColor": "{colors.dark}",
      "textColor": "{colors.surface}",
      "typography": "{typography.body}",
      "rounded": "{rounded.small}"
    },
    "button-share": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.surface}",
      "typography": "{typography.caption}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "answer": {
      "textColor": "{colors.text}",
      "typography": "{typography.answer}",
      "width": "{spacing.answer}"
    },
    "answer-title": {
      "typography": "{typography.page-title}"
    },
    "connectors-heading": {
      "typography": "{typography.section-title}"
    },
    "dialog-heading": {
      "typography": "{typography.dialog-title}"
    }
  }
}
