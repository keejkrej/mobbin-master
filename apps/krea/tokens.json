{
  "version": "alpha",
  "name": "Krea AI image and video study",
  "description": "Two screenshot-derived creative composers with inferred local result and gallery states, observed through Mobbin on November 16, 2026.",
  "colors": {
    "primary": "#ffffff",
    "on-primary": "#080808",
    "canvas": "#ffffff",
    "surface": "#f4f4f4",
    "secondary": "#8e8e8e",
    "border": "#ececec",
    "video": "#f7a600",
    "blue": "#0877f9",
    "dark-canvas": "#111111",
    "dark-surface": "#202020",
    "dark-chip": "#303030"
  },
  "typography": {
    "headline-image": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "90px",
      "fontWeight": 600,
      "lineHeight": 1.1,
      "letterSpacing": "-3px"
    },
    "headline-video": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "48px",
      "fontWeight": 700,
      "lineHeight": 1.1,
      "letterSpacing": "-2px"
    },
    "headline-gallery": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "40px",
      "fontWeight": 500,
      "lineHeight": 1.2,
      "letterSpacing": "-1.5px"
    },
    "headline-result": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "29px",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "-0.8px"
    },
    "headline-dialog": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "24px",
      "fontWeight": 500,
      "lineHeight": 1.2,
      "letterSpacing": "-0.7px"
    },
    "body-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "body-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.7
    },
    "label-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "13px",
      "fontWeight": 600,
      "lineHeight": 1.3
    },
    "label-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.45
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.2
    }
  },
  "rounded": {
    "sm": "10px",
    "md": "16px",
    "lg": "24px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "32px",
    "header": "70px",
    "video-composer": "590px",
    "image-composer": "764px"
  },
  "components": {
    "generate": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.on-primary}",
      "rounded": "15px",
      "height": "65px",
      "typography": "{typography.label-md}"
    },
    "light-canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.on-primary}"
    },
    "light-composer": {
      "backgroundColor": "{colors.surface}",
      "rounded": "{rounded.lg}"
    },
    "dark-canvas": {
      "backgroundColor": "{colors.dark-canvas}",
      "textColor": "{colors.primary}"
    },
    "dark-composer": {
      "backgroundColor": "{colors.dark-surface}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.lg}"
    },
    "dark-option-chip": {
      "backgroundColor": "{colors.dark-chip}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.full}",
      "typography": "{typography.caption}"
    },
    "supporting-label": {
      "textColor": "{colors.secondary}",
      "typography": "{typography.label-sm}"
    },
    "border-stroke": {
      "backgroundColor": "{colors.border}",
      "width": "1px"
    },
    "video-icon": {
      "backgroundColor": "{colors.video}",
      "textColor": "{colors.primary}",
      "rounded": "12px",
      "size": "41px"
    },
    "model-tip": {
      "backgroundColor": "{colors.blue}",
      "textColor": "{colors.primary}",
      "rounded": "7px",
      "typography": "{typography.label-md}"
    },
    "example-art": {
      "rounded": "11px",
      "width": "184px",
      "height": "115px"
    }
  }
}
