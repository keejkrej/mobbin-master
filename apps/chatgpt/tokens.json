{
  "version": "alpha",
  "name": "ChatGPT Web Study",
  "description": "A source-backed reconstruction of ChatGPT conversation and navigation surfaces, with inferred local interaction states.",
  "colors": {
    "primary": "#0d0d0d",
    "secondary": "#676767",
    "tertiary": "#0285ff",
    "neutral": "#ffffff",
    "sidebar": "#f9f9f9",
    "surface": "#f5f5f5",
    "hover": "#ececec",
    "border": "#e5e5e5",
    "plus": "#6354bd",
    "plus-surface": "#f3f1fb"
  },
  "typography": {
    "headline": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "29px",
      "fontWeight": 500,
      "lineHeight": 1.5,
      "letterSpacing": "-0.7px"
    },
    "toolbar": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": "28px"
    },
    "body": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.65
    },
    "body-strong": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 700,
      "lineHeight": 1.65
    },
    "heading-small": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "18px",
      "fontWeight": 700,
      "lineHeight": 1.4,
      "letterSpacing": "-0.15px"
    },
    "label": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "disclaimer": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "citation": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "9px",
      "fontWeight": 400,
      "lineHeight": 1.6
    }
  },
  "rounded": {
    "sm": "8px",
    "md": "12px",
    "lg": "24px",
    "composer": "32px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "sidebar": "264px",
    "conversation": "780px",
    "toolbar": "54px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.neutral}",
      "typography": "{typography.label}",
      "rounded": "{rounded.full}",
      "padding": "11px"
    },
    "button-icon": {
      "textColor": "{colors.primary}",
      "rounded": "{rounded.sm}",
      "size": "34px"
    },
    "button-icon-hover": {
      "backgroundColor": "{colors.hover}"
    },
    "hairline": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "button-plus": {
      "backgroundColor": "{colors.plus-surface}",
      "textColor": "{colors.plus}",
      "typography": "{typography.label}",
      "rounded": "{rounded.full}"
    },
    "chat-bubble": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.primary}",
      "typography": "{typography.body}",
      "rounded": "{rounded.lg}",
      "padding": "16px"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "width": "{spacing.sidebar}"
    },
    "composer": {
      "backgroundColor": "{colors.neutral}",
      "textColor": "{colors.primary}",
      "typography": "{typography.body}",
      "rounded": "{rounded.composer}",
      "height": "58px"
    },
    "citation": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.secondary}",
      "typography": "{typography.citation}",
      "rounded": "{rounded.full}"
    }
  }
}
