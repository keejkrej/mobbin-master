{
  "version": "alpha",
  "name": "Claude \u2014 Warm conversation study",
  "description": "A screenshot-derived design system for Claude web, observed in Mobbin on November 16, 2026.",
  "colors": {
    "primary": "#c96f4e",
    "primary-hover": "#b55f40",
    "canvas": "#fbf9f5",
    "sidebar": "#faf8f4",
    "surface": "#ffffff",
    "text": "#292924",
    "muted": "#73726c",
    "border": "#e1dfd9",
    "hover": "#efeee6",
    "dark": "#171816"
  },
  "typography": {
    "display": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "42px",
      "fontWeight": 400,
      "lineHeight": 1.2,
      "letterSpacing": "-1.3px"
    },
    "page-title": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "26px",
      "fontWeight": 400,
      "lineHeight": 1.2,
      "letterSpacing": "-0.6px"
    },
    "modal-title": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "24px",
      "fontWeight": 400,
      "lineHeight": 1.2
    },
    "assistant": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.75
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "composer": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.45
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.3
    }
  },
  "rounded": {
    "small": "6px",
    "medium": "10px",
    "large": "20px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "base": "16px",
    "large": "24px",
    "sidebar": "274px",
    "composer": "644px",
    "list": "792px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "width": "{spacing.sidebar}"
    },
    "sidebar-item": {
      "textColor": "{colors.text}",
      "typography": "{typography.body}",
      "rounded": "{rounded.small}",
      "height": "31px"
    },
    "sidebar-item-hover": {
      "backgroundColor": "{colors.hover}"
    },
    "composer": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.large}",
      "typography": "{typography.composer}",
      "width": "{spacing.composer}"
    },
    "send-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.surface}",
      "rounded": "8px",
      "height": "30px",
      "width": "30px"
    },
    "send-button-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "button-primary": {
      "backgroundColor": "{colors.dark}",
      "textColor": "{colors.surface}",
      "rounded": "8px",
      "typography": "{typography.label}",
      "height": "34px"
    },
    "metadata": {
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "welcome-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.display}"
    },
    "chat-list-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.page-title}"
    },
    "modal-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.modal-title}"
    },
    "assistant-message": {
      "textColor": "{colors.text}",
      "typography": "{typography.assistant}"
    }
  }
}
