{
  "version": "alpha",
  "name": "Suno — Dark music creation workspace",
  "description": "A Mobbin screenshot-derived Suno web design system with local sample songs and silent playback previews.",
  "colors": {
    "primary": "#F86C43",
    "primary-end": "#E43C8B",
    "canvas": "#101012",
    "surface": "#19191B",
    "card": "#171719",
    "raised": "#232326",
    "text": "#F5F5F5",
    "muted": "#A1A1A7",
    "dim": "#737378",
    "border": "#2B2B2E",
    "success": "#65CA93"
  },
  "typography": {
    "brand": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "32px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "1px"
    },
    "dialog-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "24px",
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": "-0.8px"
    },
    "page-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "action": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "17px",
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "navigation": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.44
    },
    "song-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "small": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "rounded": {
    "small": "8px",
    "medium": "14px",
    "card": "24px",
    "dialog": "40px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "large": "24px",
    "xl": "32px",
    "player": "106px",
    "creator-min": "360px",
    "sidebar-min": "190px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}"
    },
    "wordmark": {
      "textColor": "{colors.text}",
      "typography": "{typography.brand}"
    },
    "navigation": {
      "textColor": "{colors.dim}",
      "typography": "{typography.navigation}",
      "rounded": "{rounded.small}"
    },
    "navigation-active": {
      "textColor": "{colors.text}"
    },
    "workspace-title": {
      "textColor": "{colors.text}",
      "typography": "{typography.page-title}"
    },
    "workspace-muted": {
      "textColor": "{colors.muted}"
    },
    "description": {
      "backgroundColor": "{colors.card}",
      "textColor": "{colors.text}",
      "typography": "{typography.body}",
      "rounded": "{rounded.card}",
      "padding": "{spacing.base}"
    },
    "description-label": {
      "typography": "{typography.label}"
    },
    "pill": {
      "backgroundColor": "{colors.raised}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.full}",
      "typography": "{typography.small}"
    },
    "inspire-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.full}"
    },
    "inspire-gradient-end": {
      "backgroundColor": "{colors.primary-end}"
    },
    "create-button": {
      "textColor": "{colors.text}",
      "rounded": "{rounded.full}",
      "typography": "{typography.action}",
      "height": "48px"
    },
    "separator": {
      "backgroundColor": "{colors.border}"
    },
    "song-title": {
      "typography": "{typography.song-title}",
      "textColor": "{colors.text}"
    },
    "song-caption": {
      "typography": "{typography.caption}",
      "textColor": "{colors.muted}"
    },
    "dialog": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.dialog}",
      "padding": "{spacing.large}",
      "typography": "{typography.dialog-title}"
    },
    "player": {
      "backgroundColor": "{colors.surface}",
      "height": "{spacing.player}"
    },
    "challenge-time": {
      "textColor": "{colors.success}",
      "typography": "{typography.small}"
    },
    "attachment": {
      "backgroundColor": "{colors.raised}",
      "rounded": "{rounded.medium}",
      "padding": "{spacing.sm}"
    }
  }
}
