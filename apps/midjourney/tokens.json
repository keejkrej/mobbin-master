{
  "version": "alpha",
  "name": "Midjourney \u2014 Image workshop study",
  "description": "An inferred Midjourney web design system from four Mobbin references.",
  "colors": {
    "primary": "#c93518",
    "text": "#28292d",
    "muted": "#686b74",
    "canvas": "#fdfdfd",
    "surface": "#ffffff",
    "panel": "#fafafa",
    "border": "#e5e5e7",
    "quiet": "#f1f3f4",
    "accent-soft": "#fff0ec",
    "accent-border": "#f8dfd8",
    "focus": "#ca3c20"
  },
  "typography": {
    "wordmark": {
      "fontFamily": "Inter",
      "fontSize": "20px",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "0.01em"
    },
    "heading": {
      "fontFamily": "Inter",
      "fontSize": "17px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "body": {
      "fontFamily": "Inter",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "navigation": {
      "fontFamily": "Inter",
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "prompt": {
      "fontFamily": "Inter",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "Inter",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Inter",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "small": "6px",
    "medium": "10px",
    "large": "14px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "base": "16px",
    "large": "24px",
    "sidebar": "208px",
    "detail": "365px",
    "toolbar": "52px",
    "control": "32px",
    "thumb": "63px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "sidebar": {
      "backgroundColor": "{colors.canvas}",
      "width": "{spacing.sidebar}",
      "typography": "{typography.navigation}"
    },
    "selected-navigation": {
      "backgroundColor": "{colors.accent-soft}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.full}"
    },
    "selected-navigation-border": {
      "backgroundColor": "{colors.accent-border}",
      "height": "1px"
    },
    "imagine-bar": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.large}",
      "typography": "{typography.prompt}",
      "height": "{spacing.toolbar}"
    },
    "detail-panel": {
      "backgroundColor": "{colors.panel}",
      "textColor": "{colors.text}",
      "typography": "{typography.body}",
      "width": "{spacing.detail}"
    },
    "action-button": {
      "backgroundColor": "{colors.quiet}",
      "textColor": "{colors.muted}",
      "typography": "{typography.label}",
      "rounded": "{rounded.small}",
      "height": "32px"
    },
    "primary-button": {
      "backgroundColor": "{colors.text}",
      "textColor": "{colors.surface}",
      "rounded": "{rounded.medium}"
    },
    "section-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.heading}"
    },
    "brand-wordmark": {
      "textColor": "{colors.text}",
      "typography": "{typography.wordmark}"
    },
    "muted-label": {
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "focus-indicator": {
      "backgroundColor": "{colors.focus}",
      "size": "2px"
    }
  }
}
