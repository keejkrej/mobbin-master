{
  "version": "alpha",
  "name": "ElevenLabs Text to Speech study",
  "description": "An inferred light audio workspace from two Mobbin ElevenLabs web references retrieved November 16, 2026.",
  "colors": {
    "primary": "#141414",
    "canvas": "#ffffff",
    "sidebar": "#fafafa",
    "surface": "#f6f6f6",
    "selected": "#efefef",
    "border": "#e6e6e6",
    "text": "#141414",
    "secondary": "#777777",
    "slider": "#17202b",
    "tag": "#a349bf",
    "track": "#e5e5e5"
  },
  "typography": {
    "headline-dialog": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "22px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "-0.5px"
    },
    "brand": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "21px",
      "fontWeight": 700,
      "lineHeight": 1.2,
      "letterSpacing": "-0.8px"
    },
    "editor": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "navigation": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "label-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "body-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "body-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "label-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "micro": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "10px",
      "fontWeight": 600,
      "lineHeight": 1
    }
  },
  "rounded": {
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "32px",
    "sidebar": "244px",
    "header": "48px",
    "player": "80px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.canvas}",
      "rounded": "11px",
      "height": "36px",
      "typography": "{typography.body-md}"
    },
    "shell": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "width": "{spacing.sidebar}"
    },
    "navigation-selected": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.text}",
      "rounded": "9px",
      "height": "33px"
    },
    "voice-notice": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "10px",
      "padding": "12px"
    },
    "panel-divider": {
      "backgroundColor": "{colors.border}",
      "width": "1px"
    },
    "supporting-label": {
      "textColor": "{colors.secondary}",
      "typography": "{typography.label-sm}"
    },
    "slider-fill": {
      "backgroundColor": "{colors.slider}",
      "height": "4px",
      "rounded": "{rounded.full}"
    },
    "slider-track": {
      "backgroundColor": "{colors.track}",
      "height": "4px",
      "rounded": "{rounded.full}"
    },
    "expression-cue-reference": {
      "textColor": "{colors.tag}",
      "rounded": "4px"
    },
    "dialog": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.lg}",
      "padding": "{spacing.lg}"
    }
  }
}
