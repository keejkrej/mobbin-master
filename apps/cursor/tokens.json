{
  "version": "alpha",
  "name": "Cursor Web Agents",
  "description": "A visual reconstruction of the Cursor web-agent composer from Mobbin desktop references; tokens are inferred, not official source values.",
  "colors": {
    "primary": "#202020",
    "secondary": "#626262",
    "canvas": "#f7f7f7",
    "sidebar": "#f3f3f3",
    "surface": "#fdfdfd",
    "hover": "#ededed",
    "selected": "#eeeeee",
    "faint": "#8c8c8c",
    "border": "#e5e5e5",
    "line": "#dddddd",
    "enabled": "#238c6b",
    "send": "#191919",
    "on-send": "#ffffff"
  },
  "typography": {
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "toolbar": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.45
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.45
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "heading": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "22px",
      "fontWeight": 500,
      "lineHeight": 1.45
    }
  },
  "rounded": {
    "sm": "6px",
    "md": "10px",
    "lg": "18px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "compact": "12px",
    "md": "16px",
    "lg": "24px",
    "composer-width": "812px",
    "composer-top": "96px",
    "model-popup-width": "334px",
    "tool-popup-width": "280px"
  },
  "components": {
    "main-panel": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.primary}"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "textColor": "{colors.primary}"
    },
    "navigation-hover": {
      "backgroundColor": "{colors.hover}",
      "textColor": "{colors.primary}",
      "rounded": "{rounded.sm}"
    },
    "model-selected": {
      "backgroundColor": "{colors.selected}",
      "textColor": "{colors.primary}",
      "typography": "{typography.toolbar}",
      "rounded": "{rounded.sm}"
    },
    "empty-agent-label": {
      "textColor": "{colors.faint}",
      "typography": "{typography.body}"
    },
    "popup-divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "sidebar-divider": {
      "backgroundColor": "{colors.line}",
      "width": "1px"
    },
    "composer": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.primary}",
      "typography": "{typography.body}",
      "rounded": "{rounded.lg}",
      "padding": "{spacing.md}",
      "width": "{spacing.composer-width}",
      "height": "170px"
    },
    "send-button": {
      "backgroundColor": "{colors.send}",
      "textColor": "{colors.on-send}",
      "rounded": "{rounded.full}",
      "size": "31px"
    },
    "popup": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.primary}",
      "typography": "{typography.toolbar}",
      "rounded": "{rounded.md}",
      "padding": "{spacing.xs}"
    },
    "suggestion": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.secondary}",
      "typography": "{typography.body}",
      "rounded": "{rounded.full}",
      "height": "35px"
    },
    "switch-active": {
      "backgroundColor": "{colors.enabled}",
      "rounded": "{rounded.full}",
      "width": "36px",
      "height": "21px"
    }
  }
}
