{
  "version": "alpha",
  "name": "FLORA \u2014 Connected creative canvas",
  "description": "A reference-derived expressive FLORA website with an interactive media canvas and Teams page.",
  "colors": {
    "primary": "#ffffff",
    "canvas": "#000000",
    "surface": "#171717",
    "raised": "#202020",
    "text": "#f5f5f5",
    "muted": "#b0b0b0",
    "subtle": "#8a8a8a",
    "border": "#303030",
    "grid": "#151515",
    "new": "#a5d8ae",
    "pink": "#f391a6",
    "mint": "#75d9bd",
    "gold": "#f6c54c",
    "focus": "#d9e9d9"
  },
  "typography": {
    "brand": {
      "fontFamily": "Georgia",
      "fontSize": "32px",
      "fontWeight": 400,
      "lineHeight": 1,
      "letterSpacing": "-0.06em"
    },
    "display": {
      "fontFamily": "Georgia",
      "fontSize": "48px",
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": "-0.04em"
    },
    "team-heading": {
      "fontFamily": "Georgia",
      "fontSize": "34px",
      "fontWeight": 400,
      "lineHeight": 1.2,
      "letterSpacing": "-0.035em"
    },
    "section-heading": {
      "fontFamily": "Inter",
      "fontSize": "27px",
      "fontWeight": 400,
      "lineHeight": 1.3,
      "letterSpacing": "-0.035em"
    },
    "body": {
      "fontFamily": "Inter",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "navigation": {
      "fontFamily": "Inter",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "feature-heading": {
      "fontFamily": "Inter",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.3,
      "letterSpacing": "-0.02em"
    },
    "label": {
      "fontFamily": "Inter",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Inter",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "rounded": {
    "small": "10px",
    "medium": "16px",
    "large": "24px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "base": "16px",
    "large": "24px",
    "wide": "48px",
    "header": "68px",
    "content": "1182px",
    "grid-step": "14px"
  },
  "components": {
    "page": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "header": {
      "height": "{spacing.header}",
      "width": "{spacing.content}",
      "typography": "{typography.navigation}"
    },
    "wordmark": {
      "textColor": "{colors.primary}",
      "typography": "{typography.brand}"
    },
    "hero-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.display}"
    },
    "team-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.team-heading}"
    },
    "section-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.section-heading}"
    },
    "hero-description": {
      "textColor": "{colors.muted}",
      "typography": "{typography.body}"
    },
    "light-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.canvas}",
      "rounded": "{rounded.medium}"
    },
    "dark-button": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.muted}",
      "rounded": "{rounded.medium}"
    },
    "feature-card": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.large}"
    },
    "feature-heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.feature-heading}"
    },
    "media-label": {
      "textColor": "{colors.muted}",
      "typography": "{typography.label}"
    },
    "metadata": {
      "textColor": "{colors.subtle}",
      "typography": "{typography.caption}"
    },
    "new-label": {
      "textColor": "{colors.new}",
      "typography": "{typography.label}"
    },
    "border": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "canvas-dot": {
      "backgroundColor": "{colors.grid}",
      "size": "2px"
    },
    "toast": {
      "backgroundColor": "{colors.raised}",
      "textColor": "{colors.text}"
    },
    "cursor-justine": {
      "textColor": "{colors.pink}"
    },
    "cursor-francisco": {
      "textColor": "{colors.mint}"
    },
    "cursor-charlie": {
      "textColor": "{colors.gold}"
    },
    "focus-ring": {
      "backgroundColor": "{colors.focus}",
      "size": "2px"
    }
  }
}
