{
  "version": "alpha",
  "name": "Cartesia voice research website study",
  "description": "A screenshot-derived green and serif marketing system with local voice and transcript interactions.",
  "colors": {
    "primary": "#00512b",
    "on-primary": "#ffffff",
    "paper": "#f9f9f9",
    "ink": "#1d201b",
    "accent": "#389955",
    "soft": "#f1f0ec",
    "border": "#e1e2dc",
    "muted": "#5b6059",
    "on-hero": "#f4f5ec",
    "hero-copy": "#b8cbb9"
  },
  "typography": {
    "hero": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "48px",
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": "-0.9px"
    },
    "mission": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "36px",
      "fontWeight": 400,
      "lineHeight": 1.18,
      "letterSpacing": "-0.45px"
    },
    "section": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "25px",
      "fontWeight": 400,
      "lineHeight": 1.14,
      "letterSpacing": "-0.1px"
    },
    "feature": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "24px",
      "fontWeight": 400,
      "lineHeight": 1.2
    },
    "dialog": {
      "fontFamily": "Georgia, Times New Roman, serif",
      "fontSize": "30px",
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": "-0.5px"
    },
    "hero-body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "23px",
      "fontWeight": 400,
      "lineHeight": 1.4,
      "letterSpacing": "-0.3px"
    },
    "mission-body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.34,
      "letterSpacing": "-0.25px"
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.36
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.25
    },
    "small": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.6
    }
  },
  "rounded": {
    "sm": "6px",
    "md": "9px",
    "lg": "15px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "48px",
    "header": "61px",
    "section-divider": "39px",
    "frame-maximum": "1584px"
  },
  "components": {
    "primary-button": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.on-primary}",
      "rounded": "{rounded.sm}",
      "typography": "{typography.label}",
      "height": "34px"
    },
    "page": {
      "backgroundColor": "{colors.paper}",
      "textColor": "{colors.ink}"
    },
    "hero": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.on-hero}",
      "rounded": "{rounded.lg}",
      "typography": "{typography.hero}"
    },
    "hero-description": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.hero-copy}",
      "typography": "{typography.hero-body}"
    },
    "accent-heading": {
      "backgroundColor": "{colors.paper}",
      "textColor": "{colors.accent}",
      "typography": "{typography.section}"
    },
    "feature-panel": {
      "backgroundColor": "{colors.soft}",
      "textColor": "{colors.ink}",
      "typography": "{typography.body}"
    },
    "supporting-text": {
      "backgroundColor": "{colors.paper}",
      "textColor": "{colors.muted}",
      "typography": "{typography.small}"
    },
    "grid-stroke": {
      "backgroundColor": "{colors.border}",
      "width": "1px"
    },
    "industry-tab": {
      "backgroundColor": "{colors.soft}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.md}"
    },
    "dialog": {
      "backgroundColor": "{colors.paper}",
      "textColor": "{colors.ink}",
      "rounded": "13px",
      "typography": "{typography.dialog}"
    }
  }
}
