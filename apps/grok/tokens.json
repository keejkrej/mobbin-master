{
  "version": "alpha",
  "name": "Grok web conversation study",
  "description": "An inferred monochrome Grok interface from two Mobbin web screenshots retrieved November 16, 2026.",
  "colors": {
    "primary": "#080808",
    "canvas": "#fdfdfd",
    "text": "#101010",
    "secondary": "#686868",
    "surface": "#f7f7f7",
    "hover": "#efefef",
    "border": "#e7e7e7",
    "white": "#ffffff"
  },
  "typography": {
    "headline-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "32px",
      "fontWeight": 500,
      "lineHeight": 1.2,
      "letterSpacing": "-1px"
    },
    "headline-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "19px",
      "fontWeight": 600,
      "lineHeight": 1.4
    },
    "headline-sm": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 600,
      "lineHeight": 1.5
    },
    "body-wide": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "20px",
      "fontWeight": 400,
      "lineHeight": 1.7
    },
    "body-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.8
    },
    "body-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "15px",
      "fontWeight": 400,
      "lineHeight": 1.8
    },
    "label-lg": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "14px",
      "fontWeight": 600,
      "lineHeight": 1.4
    },
    "label-md": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "13px",
      "fontWeight": 600,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.7
    },
    "label-compact": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "fontSize": "11px",
      "fontWeight": 600,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "full": "9999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "base": "16px",
    "lg": "24px",
    "xl": "32px",
    "sidebar": "248px",
    "content": "760px",
    "header": "63px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}"
    },
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.white}",
      "rounded": "14px",
      "typography": "{typography.label-md}",
      "padding": "16px"
    },
    "navigation": {
      "textColor": "{colors.text}",
      "typography": "{typography.label-lg}",
      "rounded": "9px",
      "height": "40px"
    },
    "navigation-hover": {
      "backgroundColor": "{colors.hover}"
    },
    "composer": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.full}",
      "height": "59px"
    },
    "message": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.lg}",
      "padding": "16px",
      "typography": "{typography.body-lg}"
    },
    "metadata": {
      "textColor": "{colors.secondary}",
      "typography": "{typography.label-md}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "width": "1px"
    },
    "icon-button": {
      "rounded": "{rounded.full}",
      "size": "32px"
    },
    "feedback-image": {
      "rounded": "{rounded.md}"
    }
  }
}
