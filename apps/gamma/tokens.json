{
  "version": "alpha",
  "name": "Gamma \u2014 Portfolio card editor study",
  "description": "A source-backed Gamma editor with an inferred local presentation flow, based on two Mobbin web captures inspected November 16, 2026.",
  "colors": {
    "primary": "#0646ad",
    "chrome": "#ffffff",
    "text": "#09244b",
    "muted": "#7e8a98",
    "border": "#e3e8ee",
    "hover": "#f0f5fb",
    "card": "#fff8ef",
    "card-text": "#2b4141",
    "card-accent": "#c7610a",
    "workspace": "#eef1c2",
    "prism-card": "#e7e8efcc",
    "prism-text": "#353646",
    "midnight-card": "#192a39",
    "midnight-text": "#f3efeb"
  },
  "typography": {
    "hero": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "42px",
      "fontWeight": 700,
      "lineHeight": 1.27,
      "letterSpacing": "-1.1px"
    },
    "slide-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "30px",
      "fontWeight": 700,
      "lineHeight": 1.25,
      "letterSpacing": "-0.5px"
    },
    "slide-body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "17px",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "section-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "17px",
      "fontWeight": 600,
      "lineHeight": 1.15,
      "letterSpacing": "0.5px"
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "dialog-title": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "19px",
      "fontWeight": 600,
      "lineHeight": 1.3,
      "letterSpacing": "-0.4px"
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": 500,
      "lineHeight": 1.5
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "10px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "thumbnail": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "4.5px",
      "fontWeight": 700,
      "lineHeight": 1.3
    }
  },
  "rounded": {
    "small": "6px",
    "medium": "8px",
    "dialog": "15px",
    "card": "37px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "medium": "12px",
    "base": "16px",
    "large": "24px",
    "card-gap": "64px",
    "title-inset": "63px",
    "topbar": "50px",
    "thumbnails": "146px"
  },
  "components": {
    "editor-toolbar": {
      "backgroundColor": "{colors.chrome}",
      "textColor": "{colors.text}",
      "typography": "{typography.body}",
      "height": "{spacing.topbar}"
    },
    "toolbar-button-hover": {
      "backgroundColor": "{colors.hover}"
    },
    "button-present": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.chrome}",
      "typography": "{typography.body}",
      "rounded": "{rounded.full}"
    },
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.chrome}",
      "typography": "{typography.label}",
      "rounded": "{rounded.medium}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "metadata": {
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "workspace": {
      "backgroundColor": "{colors.workspace}"
    },
    "slide": {
      "backgroundColor": "{colors.card}",
      "textColor": "{colors.card-text}",
      "rounded": "{rounded.card}"
    },
    "slide-accent": {
      "backgroundColor": "{colors.card-accent}"
    },
    "slide-prism": {
      "backgroundColor": "{colors.prism-card}"
    },
    "slide-prism-text": {
      "textColor": "{colors.prism-text}"
    },
    "slide-midnight": {
      "backgroundColor": "{colors.midnight-card}",
      "textColor": "{colors.midnight-text}"
    },
    "hero-title": {
      "textColor": "{colors.card-text}",
      "typography": "{typography.hero}"
    },
    "content-heading": {
      "typography": "{typography.slide-title}"
    },
    "content-body": {
      "typography": "{typography.slide-body}"
    },
    "content-section-heading": {
      "typography": "{typography.section-title}"
    },
    "card-thumbnail": {
      "backgroundColor": "{colors.card}",
      "textColor": "{colors.card-text}",
      "typography": "{typography.thumbnail}",
      "rounded": "{rounded.small}"
    },
    "dialog-heading": {
      "typography": "{typography.dialog-title}"
    }
  }
}
