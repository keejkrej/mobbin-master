{
  "version": "alpha",
  "name": "Lindy — Warm agent workspace study",
  "description": "An inferred design system from two Lindy web screens supplied by Mobbin MCP on November 16, 2026.",
  "colors": {
    "primary": "#0097fa",
    "primary-hover": "#0085dc",
    "text": "#171b1d",
    "muted": "#797e81",
    "canvas": "#ffffff",
    "sidebar": "#ffffff",
    "hover": "#f3f4f5",
    "border": "#e4e5e7",
    "send-disabled": "#98b2ff",
    "purple": "#7352d5",
    "purple-surface": "#f0ebff",
    "green": "#2bb86f",
    "blue": "#4587d8",
    "warm": "#fff3cf",
    "peach": "#fbefe4",
    "flow": "#fafbfc",
    "selected": "#e6f9fd",
    "selected-border": "#339cb2"
  },
  "typography": {
    "heading": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "32px",
      "fontWeight": 500,
      "lineHeight": 1.2
    },
    "body": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "caption": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "node": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "builder": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontSize": "13px",
      "fontWeight": 400,
      "lineHeight": 1.75
    },
    "code": {
      "fontFamily": "Courier New, monospace",
      "fontSize": "12px",
      "fontWeight": 700,
      "lineHeight": 1.6
    }
  },
  "rounded": {
    "small": "6px",
    "medium": "10px",
    "large": "15px",
    "full": "999px"
  },
  "spacing": {
    "xs": "4px",
    "small": "8px",
    "base": "16px",
    "large": "24px",
    "sidebar": "242px",
    "builder": "380px",
    "inspector": "380px",
    "composer": "714px"
  },
  "components": {
    "canvas": {
      "backgroundColor": "{colors.canvas}"
    },
    "sidebar": {
      "backgroundColor": "{colors.sidebar}",
      "width": "{spacing.sidebar}"
    },
    "navigation": {
      "textColor": "{colors.text}",
      "typography": "{typography.body}",
      "rounded": "{rounded.small}"
    },
    "navigation-selected": {
      "backgroundColor": "{colors.hover}"
    },
    "divider": {
      "backgroundColor": "{colors.border}",
      "height": "1px"
    },
    "home-warm-glow": {
      "backgroundColor": "{colors.warm}"
    },
    "home-peach-glow": {
      "backgroundColor": "{colors.peach}"
    },
    "heading": {
      "textColor": "{colors.text}",
      "typography": "{typography.heading}"
    },
    "composer": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.large}",
      "width": "{spacing.composer}",
      "padding": "{spacing.base}"
    },
    "send-disabled": {
      "backgroundColor": "{colors.send-disabled}",
      "textColor": "{colors.canvas}",
      "rounded": "{rounded.full}",
      "width": "35px",
      "height": "35px"
    },
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.canvas}",
      "rounded": "{rounded.small}",
      "typography": "{typography.label}",
      "height": "31px"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.primary-hover}"
    },
    "suggestion-green-icon": {
      "textColor": "{colors.green}"
    },
    "suggestion-blue-icon": {
      "textColor": "{colors.blue}"
    },
    "metadata": {
      "textColor": "{colors.muted}",
      "typography": "{typography.caption}"
    },
    "flow-canvas": {
      "backgroundColor": "{colors.flow}"
    },
    "flow-node": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "rounded": "12px",
      "typography": "{typography.node}",
      "width": "305px",
      "height": "46px"
    },
    "flow-node-selected": {
      "backgroundColor": "{colors.selected}"
    },
    "flow-node-selected-outline": {
      "backgroundColor": "{colors.selected-border}",
      "height": "1px"
    },
    "builder": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "typography": "{typography.builder}",
      "width": "{spacing.builder}",
      "rounded": "13px"
    },
    "builder-code": {
      "typography": "{typography.code}"
    },
    "inspector": {
      "backgroundColor": "{colors.canvas}",
      "width": "{spacing.inspector}"
    },
    "dialog": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.text}",
      "rounded": "{rounded.large}",
      "padding": "23px"
    },
    "build-agent-icon": {
      "backgroundColor": "{colors.purple-surface}",
      "textColor": "{colors.purple}",
      "rounded": "3px"
    }
  }
}
